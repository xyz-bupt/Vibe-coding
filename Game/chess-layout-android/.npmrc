# npm Security Configuration

# Prevent installation of packages during install
# Use 'npm audit fix' separately to review changes
# save-exact = true

# Enable strict peer dependencies
strict-peer-deps = true

# Only allow registries with provenance
# registry = https://registry.npmjs.org/

# Use engine-strict to require Node version match
engine-strict = true

# Fund messages disabled for cleaner output
fund = false

# Audit level
audit-level = moderate

# Force SSL for registry communication
always-auth = false
strict-ssl = true

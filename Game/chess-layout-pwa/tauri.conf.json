{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "象棋布局教学",
  "version": "0.0.1",
  "identifier": "com.chesslayout.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "象棋布局教学",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/1024x1024.png"
    ],
    "category": "Education",
    "copyright": "Copyright © 2024 ChessLayout",
    "longDescription": "象棋布局教学桌面应用，帮助用户学习中国象棋的各种布局和战术",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.0.0",
  "description": "Stay focused and block distractions while browsing",
  "icons": {
    "16": "icons/icon-default-16.png",
    "48": "icons/icon-default-48.png",
    "128": "icons/icon-default-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-default-16.png",
      "48": "icons/icon-default-48.png",
      "128": "icons/icon-default-128.png"
    },
    "default_title": "Focus Mode",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ]
}
